---
import MainLayout from '../components/layout/MainLayout.astro';
import { getCollection } from 'astro:content';
// @ts-ignore - YAML import works at runtime, Astro YAML plugin handles type resolution
import resumeData from '../data/resume.yaml';

const allPosts = await getCollection('blog');
const blogPosts = allPosts.filter(post => !post.id.startsWith('archive/'));
const sortedPosts = blogPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<MainLayout 
  title="Blog - Albert Wei"
  description="Read my latest articles and thoughts"
>
  <article class="content-default">
    <header class="page-header">
      <h1>Blog</h1>
      <p> 🚧 Under construction 🚧 </p>
    </header>

    {sortedPosts.length > 0 ? (
      <div class="grid-1">
        {sortedPosts.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}`} class="blog-link">
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </time>

              <h2 class="mt-md mb-md">{post.data.title}</h2>
              
              <p class="text-secondary mb-lg">{post.data.description}</p>

              {post.data.image && (
                <img src={post.data.image} alt={post.data.title} class="blog-image" />
              )}

              <div class="tag-group mb-md">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <span class="read-more">Read Article →</span>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No blog posts yet. Check back soon!</p>
      </div>
    )}
  </article>
</MainLayout>

<style>
  .blog-link {
    display: block;
    padding: var(--space-xl);
    text-decoration: none;
    color: inherit;
  }

  .blog-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
  }

  .read-more {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .blog-card:hover .read-more {
    color: var(--color-accent-hover);
  }
</style>