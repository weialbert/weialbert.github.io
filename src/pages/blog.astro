---
import MainLayout from '../components/layout/MainLayout.astro';
import { getCollection } from 'astro:content';

const blogPosts = await getCollection('blog');
const sortedPosts = blogPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<MainLayout 
  title="Blog - Albert Wei"
  description="Read my latest articles and thoughts"
>
  <article class="blog-page">
    <header class="page-header">
      <h1>Blog</h1>
      <p>Thoughts, articles, and insights on software engineering and technology.</p>
    </header>

    {sortedPosts.length > 0 ? (
      <div class="blog-grid">
        {sortedPosts.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}`} class="blog-link">
              <div class="blog-date">
                <time datetime={post.data.publishDate.toISOString()}>
                  {post.data.publishDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric'
                  })}
                </time>
              </div>

              <h2>{post.data.title}</h2>
              
              <p class="blog-description">{post.data.description}</p>

              {post.data.image && (
                <img src={post.data.image} alt={post.data.title} class="blog-image" />
              )}

              <div class="blog-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>

              <span class="read-more">Read Article →</span>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No blog posts yet. Check back soon!</p>
      </div>
    )}
  </article>
</MainLayout>

<style>
  .blog-page {
    max-width: 800px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }

  .page-header p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  .blog-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .blog-link {
    display: block;
    padding: var(--space-xl);
    text-decoration: none;
    color: inherit;
  }

  .blog-date {
    margin-bottom: var(--space-md);
  }

  .blog-date time {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .blog-card h2 {
    margin-bottom: var(--space-md);
    font-size: var(--text-2xl);
    line-height: 1.4;
  }

  .blog-description {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    font-size: var(--text-base);
  }

  .blog-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: var(--space-lg);
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .tag {
    background-color: var(--color-bg-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .read-more {
    display: inline-block;
    color: var(--color-accent);
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .blog-card:hover .read-more {
    color: var(--color-accent-hover);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: var(--text-3xl);
    }
  }
</style>
