---
import { getCollection } from "astro:content";
import MainLayout from "../components/layout/MainLayout.astro";

const projects = await getCollection("projects");
const sortedProjects = projects
	.filter((project) => !project.data.draft)
	.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<MainLayout 
  title="Projects - Albert Wei"
  description="View my portfolio of projects and work"
>
  <article>
    <header class="page-header content-default">
      <h1>My Projects</h1>
      <p>A collection of projects I've built and contributed to.</p>
    </header>

    {sortedProjects.length > 0 ? (
      <div class="grid-1 content-wide">
        {sortedProjects.map((project) => (
          <article class="project-card-horizontal">
            <a href={`/projects/${project.id}`} class="project-link">
              <div class="project-body">
                <h2>{project.data.title}</h2>

                <p class="project-description">{project.data.description}</p>

                <div class="tag-group">
                  {project.data.techStack.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>

                <div class="project-links">
                  {project.data.githubUrl && (
                    <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="link">
                      GitHub
                    </a>
                  )}
                  {project.data.liveUrl && (
                    <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="link">
                      Live Demo
                    </a>
                  )}
                </div>
              </div>

              {project.data.image && (
                <div class="project-image">
                  <img 
                    src={project.data.image} 
                    alt={project.data.title}
                    onerror="this.parentElement.remove()"
                  />
                </div>
              )}
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state content-default">
        <p>No projects yet. Check back soon!</p>
      </div>
    )}
  </article>
</MainLayout>

<style>
  .project-card-horizontal {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .project-card-horizontal:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .project-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .project-body {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .project-body h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-md);
  }

  .project-description {
    display: block;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .tag-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .project-links {
    display: flex;
    gap: var(--space-md);
  }

  .project-image {
    width: 100%;
    height: 220px;
    overflow: hidden;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .project-card-horizontal:hover .project-image img {
    transform: scale(1.05);
  }
</style>