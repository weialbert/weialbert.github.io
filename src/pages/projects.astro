---
import MainLayout from '../components/layout/MainLayout.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
---

<MainLayout 
  title="Projects - Albert Wei"
  description="View my portfolio of projects and work"
>
  <article class="projects-page">
    <header class="page-header">
      <h1>My Projects</h1>
      <p>A collection of projects I've built and contributed to.</p>
    </header>

    {sortedProjects.length > 0 ? (
      <div class="projects-grid">
        {sortedProjects.map((project) => (
          <article class="project-card">
            <a href={`/projects/${project.slug}`} class="project-link">
              {project.data.image && (
                <div class="project-image">
                  <img src={project.data.image} alt={project.data.title} />
                </div>
              )}
              <div class="project-body">
                <h2>{project.data.title}</h2>
                <p>{project.data.description}</p>
                
                <div class="project-tech">
                  {project.data.techStack.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>

                <div class="project-links">
                  {project.data.githubUrl && (
                    <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="link">
                      GitHub
                    </a>
                  )}
                  {project.data.liveUrl && (
                    <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="link">
                      Live Demo
                    </a>
                  )}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No projects yet. Check back soon!</p>
      </div>
    )}
  </article>
</MainLayout>

<style>
  .projects-page {
    max-width: 1000px;
    margin: 0 auto;
  }

  .page-header {
    margin-bottom: var(--space-3xl);
  }

  .page-header h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }

  .page-header p {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }

  .project-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .project-link {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 0;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .project-image {
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }

  .project-card:hover .project-image img {
    transform: scale(1.05);
  }

  .project-body {
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
  }

  .project-body h2 {
    margin-bottom: var(--space-md);
    font-size: var(--text-2xl);
  }

  .project-body > p {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    flex-grow: 1;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .tech-tag {
    background-color: var(--color-bg-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .project-links {
    display: flex;
    gap: var(--space-md);
  }

  .link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
  }

  .link:hover {
    color: var(--color-accent-hover);
  }

  .empty-state {
    text-align: center;
    padding: var(--space-3xl);
    color: var(--color-text-secondary);
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: var(--text-3xl);
    }

    .project-link {
      grid-template-columns: 1fr;
    }

    .project-image {
      height: 200px;
    }
  }
</style>
