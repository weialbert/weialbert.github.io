---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import MainLayout from "../components/layout/MainLayout.astro";
import type { ResumeProfile } from "../lib/resume/profiles.schema";

const siteRoot = typeof Astro.site === "string" ? Astro.site : ".";
const profilesJsonPath = join(siteRoot, "public/resume/profiles.json");

let profiles: ResumeProfile[] = [];
try {
	const raw = readFileSync(profilesJsonPath, "utf-8");
	profiles = JSON.parse(raw) as ResumeProfile[];
} catch (err) {
	console.warn("Could not load resume profiles:", err);
}
---

<MainLayout 
  title="Resume - Albert Wei"
  description="Download my resume"
>
  <article class="content-default">
    <header class="page-header">
      <h1>Resume</h1>
      <p>View my work history, conveniently filtered using different profiles.</p>
    </header>

    <div class="grid-auto-fit">
      {profiles.map(({ name, label, description }: ResumeProfile) => (
        <article class="card">
          <h2>{label}</h2>
          <p class="text-secondary mb-lg">{description}</p>

          <div class="download-links">
            <a href={`/resume/${name}/resume.pdf`} target="_blank" class="btn btn-primary">
              View PDF
            </a> 
            <a href={`/resume/${name}/resume.typ`} target="_blank" class="btn btn-secondary">
              Source
            </a>
          </div>
        </article>
      ))}
    </div>
  </article>
</MainLayout>

<style>
.download-links {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}
</style>
