---
import MainLayout from "../components/layout/MainLayout.astro";
import { getPhotosCollection } from "../lib/content/photos";

const photos = await getPhotosCollection();
const sortedPhotos = photos.sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<MainLayout 
  title="Photography - Albert Wei"
  description="Browse my photography portfolio"
>
  <article>
    <header class="page-header content-default">
      <h1>Photography</h1>
      <p>A collection of moments captured through my lens.</p>
    </header>

    {sortedPhotos.length > 0 ? (
      <div class="photo-grid content-wide">
        {sortedPhotos.map((photo) => (
          <a href={`/photos/${photo.id}`} class="photo-item">
            <img
              src={photo.data.image}
              alt={photo.data.title}
              loading="lazy"
              decoding="async"
            />
            <div class="photo-overlay">
              <h3>{photo.data.title}</h3>
              {photo.data.location && (
                <p class="location">{photo.data.location}</p>
              )}
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>No photos yet. Check back soon!</p>
      </div>
    )}
  </article>
</MainLayout>

<style>
  .photo-item {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
</style>
