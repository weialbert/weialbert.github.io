---
import MainLayout from "../components/layout/MainLayout.astro";
import { getLatestBlogPosts } from "../lib/content/blog";
import { getPhotosCollection } from "../lib/content/photos";
import { getFeaturedProjects } from "../lib/content/projects";
import { getResumeData } from "../lib/resume/load";

const { experiences } = getResumeData();

// Get resume data
const currentRole = experiences[0];

// Get featured content
const featuredProjects = await getFeaturedProjects();
const latestPosts = await getLatestBlogPosts();
const photos = await getPhotosCollection();
const featuredPhotos = photos.filter((p) => p.data.featured).slice(0, 6);
---

<MainLayout title="Albert Wei - Data Engineer & Developer">
  <!-- Hero Section - uses global .hero classes -->
  <section id="hero" class="hero">
    <div class="hero-content">
      <h1 class="hero-title">Hi, I'm Albert Wei</h1>
      <p class="hero-subtitle">
        I'm currently a: &ensp; <code>{currentRole.role}</code>
      </p>
      <div class="hero-cta">
        <a href="/projects" class="btn btn-primary">View My Work</a>
        <a href="/contact" class="btn btn-secondary">Get In Touch</a>
      </div>
    </div>
  </section>

  <!-- Quick About - uses global .section -->
  <section id="about-preview" class="section">
    <div class="about-content content-narrow text-center">
      <h2>About Me</h2>
      <p class="text-secondary text-lg mt-lg mb-lg"> 
        I'm a {currentRole.role} based in NYC. Before that, I studied operations research at the University of Michigan class of 2022. 
        In my free time, you'll find me exploring with my camera, swimming, or cooking.
      </p>
      <a href="/about" class="btn btn-primary">Learn More</a>
    </div>
  </section>

  <!-- Featured Projects - uses global .section, .section-header, .project-card -->
  {featuredProjects.length > 0 && (
    <section id="projects" class="section">
      <div class="section-header">
        <h2>Featured Projects</h2>
        <a href="/projects" class="section-link">View All →</a>
      </div>
      
      <div class="grid-auto-fit">
        {featuredProjects.map((project) => (
          <article class="project-card">
            <a href={`/projects/${project.id}`}>
              {project.data.image && (
                <div class="card-media">
                  <img
                    src={project.data.image}
                    alt={project.data.title}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="project-content">
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <div class="project-tech">
                  {project.data.techStack.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Latest Blog Posts - uses global .section, .blog-card -->
  {latestPosts.length > 0 && (
    <section id="blog" class="section">
      <div class="section-header">
        <h2>Latest Posts</h2>
        <a href="/blog" class="section-link">View All →</a>
      </div>
      
      <div class="grid-auto-fit">
        {latestPosts.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.id}`}>
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en-US', {
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="tag-group mt-md">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Photo Showcase - uses global .section, .photo-grid, .photo-item -->
  {featuredPhotos.length > 0 && (
    <section id="photos" class="section">
      <div class="section-header">
        <h2>Photography</h2>
        <a href="/photos" class="section-link">View Gallery →</a>
      </div>
      
      <div class="photo-grid">
        {featuredPhotos.map((photo) => (
          <a href={`/photos/${photo.id}`} class="photo-item">
            <img
              src={photo.data.image}
              alt={String(photo.data.title)}
              loading="lazy"
              decoding="async"
            />
            
            <div class="photo-overlay">
              <span class="photo-title">{photo.data.title}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Contact CTA - uses global .cta-section -->
  <section id="contact-cta" class="section cta-section">
    <h2>Let's Work Together</h2>
    <p>Have a project in mind? Let's chat about how we can collaborate.</p>
    <a href="/contact" class="btn btn-primary">Contact Me</a>
  </section>
</MainLayout>

<style>
  .card-media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .card-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .photo-item {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }

  .photo-item img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
</style>
