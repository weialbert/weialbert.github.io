---
import MainLayout from '../components/layout/MainLayout.astro';
import { getCollection } from 'astro:content';
// @ts-ignore - YAML import works at runtime, Astro YAML plugin handles type resolution
import resumeData from '../data/resume.yaml';

// Get resume data
const resumeDataTyped = resumeData as any;
const { experiences, personal } = resumeDataTyped;
const currentRole = experiences[0];

// Get featured content
const projects = await getCollection('projects');
const featuredProjects = projects
  .filter(p => p.data.featured)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0))
  .slice(0, 3);

const blogPosts = await getCollection('blog');
const latestPosts = blogPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const photos = await getCollection('photos');
const featuredPhotos = photos
  .filter(p => p.data.featured)
  .slice(0, 6);
---

<MainLayout title="Albert Wei - Data Engineer & Developer">
  <!-- Hero Section -->
  <section id="hero" class="hero">
    <div class="hero-content">
      <h1 class="hero-title">Hi, I'm Albert Wei</h1>
      <p class="hero-subtitle">
        I'm currently a: &ensp; <code>{currentRole.role}</code>
      </p>
      <!-- <p class="hero-description">
        You'll find my work history and side projects here.<br>
        If you're looking for food pics or my travel pictures, you'll also find that here.
      </p> -->
      <div class="hero-cta">
        <a href="/projects" class="btn btn-primary">View My Work</a>
        <a href="/contact" class="btn btn-secondary">Get In Touch</a>
      </div>
    </div>
  </section>

  <!-- Quick About -->
  <section id="about-preview" class="section">
    <div class="about-content">
      <h2>About Me</h2>
      <p>
        I'm a {currentRole.role} based in NYC. Before that, I studied operations research at the University of Michigan class of 2022. 
        In my free time, you'll find me exploring with my camera, swimming, or cooking.
      </p>
      <a href="/about" class="btn btn-primary">Learn More</a>
    </div>
  </section>

  <!-- Featured Projects -->
  {featuredProjects.length > 0 && (
    <section id="projects" class="section">
      <div class="section-header">
        <h2>Featured Projects</h2>
        <a href="/projects" class="section-link">View All →</a>
      </div>
      
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <article class="project-card">
            <a href={`/projects/${project.slug}`}>
              {project.data.image && (
                <img src={project.data.image} alt={project.data.title} />
              )}
              <div class="project-content">
                <h3>{project.data.title}</h3>
                <p>{project.data.description}</p>
                <div class="project-tech">
                  {project.data.techStack.map((tech) => (
                    <span class="tech-tag">{tech}</span>
                  ))}
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Latest Blog Posts -->
  {latestPosts.length > 0 && (
    <section id="blog" class="section">
      <div class="section-header">
        <h2>Latest Posts</h2>
        <a href="/blog" class="section-link">View All →</a>
      </div>
      
      <div class="blog-grid">
        {latestPosts.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}`}>
              <time datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}
              </time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="post-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>
  )}

  <!-- Photo Showcase -->
  {featuredPhotos.length > 0 && (
    <section id="photos" class="section">
      <div class="section-header">
        <h2>Photography</h2>
        <a href="/photos" class="section-link">View Gallery →</a>
      </div>
      
      <div class="photo-grid">
        {featuredPhotos.map((photo) => (
          <a href={`/photos/${photo.slug}`} class="photo-item">
            <img src={photo.data.image} alt={photo.data.title} loading="lazy" />
            <div class="photo-overlay">
              <span class="photo-title">{photo.data.title}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Contact CTA -->
  <section id="contact-cta" class="section cta-section">
    <h2>Let's Work Together</h2>
    <p>Have a project in mind? Let's chat about how we can collaborate.</p>
    <a href="/contact" class="btn btn-primary">Contact Me</a>
  </section>
</MainLayout>

<style>
  /* Hero Section */
  .hero {
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-3xl) 0;
  }
  
  .hero-content {
    max-width: 800px;
  }
  
  .hero-title {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
  }
  
  .hero-subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }
  
  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  
  .hero-cta {
    display: flex;
    gap: var(--space-md);
    justify-content: center;
    flex-wrap: wrap;
  }
  
  /* Sections */
  .section {
    padding: var(--space-3xl) 0;
  }
  
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-xl);
  }
  
  .section-link {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--transition-fast);
  }
  
  .section-link:hover {
    color: var(--color-accent-hover);
  }
  
  /* Project Grid */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
  }
  
  .project-card {
    background-color: var(--color-card-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  
  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .project-card a {
    text-decoration: none;
    color: inherit;
  }
  
  .project-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }
  
  .project-content {
    padding: var(--space-lg);
  }
  
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  
  .tech-tag {
    background-color: var(--color-bg-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  
  /* Blog Grid */
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-xl);
  }
  
  .blog-card {
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  
  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  
  .blog-card a {
    text-decoration: none;
    color: inherit;
  }
  
  .blog-card time {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }
  
  .blog-card h3 {
    margin: var(--space-md) 0;
  }
  
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-md);
  }
  
  .tag {
    background-color: var(--color-bg-secondary);
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  
  /* Photo Grid */
  .photo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-md);
  }
  
  .photo-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
  }
  
  .photo-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-base);
  }
  
  .photo-item:hover img {
    transform: scale(1.05);
  }
  
  .photo-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.7), transparent);
    padding: var(--space-lg);
    color: white;
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  
  .photo-item:hover .photo-overlay {
    opacity: 1;
  }
  
  /* About Preview */
  .about-content {
    max-width: 700px;
    margin: 0 auto;
    text-align: center;
  }
  
  .about-content p {
    margin: var(--space-lg) 0;
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }
  
  /* CTA Section */
  .cta-section {
    text-align: center;
    background-color: var(--color-bg-secondary);
    padding: var(--space-3xl);
    border-radius: var(--radius-xl);
  }
  
  .cta-section h2 {
    margin-bottom: var(--space-md);
  }
  
  .cta-section p {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    margin-bottom: var(--space-xl);
  }
  
  /* Buttons */
  .btn {
    display: inline-block;
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
    transition: all var(--transition-fast);
  }
  
  .btn-primary {
    background-color: var(--color-accent);
    color: white;
  }
  
  .btn-primary:hover {
    background-color: var(--color-accent-hover);
  }
  
  .btn-secondary {
    background-color: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }
  
  .btn-secondary:hover {
    background-color: var(--color-accent);
    color: white;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 60vh;
      padding: var(--space-2xl) 0;
    }
    
    .section-header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-md);
    }
  }
</style>
