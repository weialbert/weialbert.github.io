---
import { getCollection, render } from "astro:content";
import MainLayout from "../../components/layout/MainLayout.astro";

export async function getStaticPaths() {
	const photos = await getCollection("photos");
	return photos.map((photo) => ({
		params: { id: photo.id },
		props: { photo },
	}));
}

const { photo } = Astro.props;
const { Content } = await render(photo);

const allPhotos = await getCollection("photos");
const currentIndex = allPhotos.findIndex((p) => p.id === photo.id);
const prevPhoto = currentIndex > 0 ? allPhotos[currentIndex - 1] : null;
const nextPhoto =
	currentIndex < allPhotos.length - 1 ? allPhotos[currentIndex + 1] : null;
---

<MainLayout 
  title={`${photo.data.title} - Photography`}
  description={photo.data.caption || photo.data.title}
  image={photo.data.image}
>
  <article class="photo-detail">
    <a href="/photos" class="back-link">← Back to Gallery</a>
    
    <div class="photo-container">
      <img src={photo.data.image} alt={photo.data.title} />
    </div>
    
    <div class="photo-info">
      <h1>{photo.data.title}</h1>
      
      <div class="photo-meta">
        <time datetime={photo.data.date.toISOString()}>
          {photo.data.date.toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
        {photo.data.location && (
          <span class="location">📍 {photo.data.location}</span>
        )}
      </div>
      
      {photo.data.caption && (
        <p class="caption">{photo.data.caption}</p>
      )}
      
      <div class="photo-tags">
        {photo.data.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
      
      {Content && (
        <div class="photo-description">
          <Content />
        </div>
      )}
    </div>
    
    <nav class="photo-navigation">
      {prevPhoto && (
        <a href={`/photos/${prevPhoto.id}`} class="nav-btn prev">
          ← Previous
        </a>
      )}
      {nextPhoto && (
        <a href={`/photos/${nextPhoto.id}`} class="nav-btn next">
          Next →
        </a>
      )}
    </nav>
  </article>
</MainLayout>

<style>
  .photo-detail {
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .back-link {
    display: inline-block;
    color: var(--color-text-secondary);
    text-decoration: none;
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }
  
  .back-link:hover {
    color: var(--color-accent);
  }
  
  .photo-container {
    margin-bottom: var(--space-2xl);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-bg-secondary);
  }
  
  .photo-container img {
    width: 100%;
    height: auto;
    display: block;
  }
  
  .photo-info {
    max-width: 800px;
    margin: 0 auto var(--space-3xl);
  }
  
  .photo-info h1 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-md);
  }
  
  .photo-meta {
    display: flex;
    gap: var(--space-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
    flex-wrap: wrap;
  }
  
  .caption {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }
  
  .photo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }
  
  .tag {
    background-color: var(--color-bg-secondary);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  
  .photo-description {
    line-height: 1.8;
    color: var(--color-text-secondary);
  }
  
  .photo-description :global(p) {
    margin-bottom: var(--space-lg);
  }
  
  .photo-description :global(h2) {
    margin-top: var(--space-xl);
    margin-bottom: var(--space-md);
  }
  
  .photo-navigation {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--color-border);
  }
  
  .nav-btn {
    padding: var(--space-md) var(--space-xl);
    background-color: var(--color-card-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-fast);
  }
  
  .nav-btn:hover {
    background-color: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }
  
  .nav-btn.next {
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .photo-navigation {
      flex-direction: column;
    }

    .nav-btn {
      width: 100%;
      text-align: center;
    }

    .nav-btn.next {
      margin-left: 0;
    }
  }
</style>
