---
import { render } from "astro:content";
import DetailPage from "../../components/content/DetailPage.astro";
import MainLayout from "../../components/layout/MainLayout.astro";
import { getPublishedProjects } from "../../lib/content/projects";

export async function getStaticPaths() {
	const projects = await getPublishedProjects();
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<MainLayout 
  title={`${project.data.title} - Projects`}
  description={project.data.description}
  image={project.data.image}
>
  <DetailPage backHref="/projects" backLabel="Back to Projects" maxWidth="900px">
    <Fragment slot="header">
      <div class="project-header">
        <h1>{project.data.title}</h1>

        <div class="project-meta">
          <div class="tech-stack">
            {project.data.techStack.map((tech) => (
              <span class="tech-tag">{tech}</span>
            ))}
          </div>

          <div class="project-actions">
            {project.data.githubUrl && (
              <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                View on GitHub
              </a>
            )}
            {project.data.liveUrl && (
              <a href={project.data.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                Live Demo
              </a>
            )}
          </div>
        </div>
      </div>
    </Fragment>

    {project.data.image && (
      <div slot="hero">
        <img
          src={project.data.image}
          alt={project.data.title}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )}

    <div class="project-body">
      <Content />
    </div>
  </DetailPage>
</MainLayout>

<style>
  .project-header h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-lg);
  }
  
  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-lg);
    margin-bottom: var(--space-2xl);
  }
  
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
  
  .tech-tag {
    background-color: var(--color-bg-secondary);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }
  
  .project-actions {
    display: flex;
    gap: var(--space-md);
  }
  
  .btn {
    padding: var(--space-md) var(--space-xl);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 500;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast);
    display: inline-block;
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: white;
  }

  .btn-primary:hover {
    background-color: var(--color-accent-hover);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-accent);
    border: 2px solid var(--color-accent);
  }

  .btn-secondary:hover {
    background-color: var(--color-accent);
    color: white;
  }

  @media (max-width: 768px) {
    .project-meta {
      flex-direction: column;
      align-items: flex-start;
    }

    .project-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
