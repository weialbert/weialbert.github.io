---
import { render } from "astro:content";
import DetailPage from "../../components/content/DetailPage.astro";
import MainLayout from "../../components/layout/MainLayout.astro";
import { formatBlogDate, getPublishedBlogPosts } from "../../lib/content/blog";

export async function getStaticPaths() {
	const posts = await getPublishedBlogPosts();
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
---

<MainLayout
  title={`${post.data.title} - Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
>
  <DetailPage backHref="/blog" backLabel="Back to Blog" maxWidth="800px">
    <Fragment slot="header">
      <div class="post-header">
        <h1>{post.data.title}</h1>

        <div class="post-meta">
          <time datetime={post.data.publishDate.toISOString()}>
            {formatBlogDate(post.data.publishDate)}
          </time>
        </div>

        <div class="post-tags">
          {
            post.data.tags.map((tag) => (
              <a href={`/blog/tags/${tag}`} class="tag">
                {tag}
              </a>
            ))
          }
        </div>
      </div>
    </Fragment>

    {
      post.data.image && (
        <div slot="hero">
          <img
            src={post.data.image}
            alt={post.data.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    {
      headings.length > 0 && (
        <aside class="toc">
          <h2>Table of Contents</h2>
          <ul>
            {headings.map((heading) => (
              <li class={`toc-${heading.depth}`}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="post-content">
      <Content />
    </div>

    <div slot="footer" class="post-footer">
      <div class="share-section">
        <h3>Share this post</h3>
        <div class="share-buttons">
          <a
            href={`https://twitter.com/intent/tweet?text=${post.data.title}&url=${Astro.url}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Twitter
          </a>
          <a
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${Astro.url}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            LinkedIn
          </a>
        </div>
      </div>

      <a href="/blog" class="back-to-blog">← Back to all posts</a>
    </div>
  </DetailPage>
</MainLayout>
<style>
  .post-header h1 {
    font-size: var(--text-4xl);
    line-height: 1.2;
    margin-bottom: var(--space-lg);
  }

  .post-meta {
    display: flex;
    gap: var(--space-md);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-lg);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .tag {
    background-color: var(--color-bg-secondary);
    padding: var(--space-xs) var(--space-md);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
  }

  .tag:hover {
    background-color: var(--color-accent);
    color: white;
  }

  .toc {
    background-color: var(--color-bg-secondary);
    padding: var(--space-xl);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-2xl);
  }

  .toc h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-md);
  }

  .toc ul {
    list-style: none;
  }

  .toc li {
    margin-bottom: var(--space-sm);
  }

  .toc a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .toc a:hover {
    color: var(--color-accent);
  }

  .toc-3 {
    padding-left: var(--space-lg);
  }

  .toc-4 {
    padding-left: calc(var(--space-lg) * 2);
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-accent);
    padding-left: var(--space-lg);
    margin: var(--space-lg) 0;
    color: var(--color-text-secondary);
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .post-content :global(a:hover) {
    color: var(--color-accent-hover);
    text-decoration: underline;
  }

  .share-section {
    margin-bottom: var(--space-2xl);
  }

  .share-section h3 {
    margin-bottom: var(--space-md);
  }

  .share-buttons {
    display: flex;
    gap: var(--space-md);
    flex-wrap: wrap;
  }

  .share-buttons a {
    padding: var(--space-md) var(--space-lg);
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .share-buttons a:hover {
    background-color: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .back-to-blog {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-to-blog:hover {
    color: var(--color-accent);
  }
</style>
