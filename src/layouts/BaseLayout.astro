---
import { ClientRouter } from "astro:transitions";
import { resolveThemeValue, THEME_STORAGE_KEY } from "../lib/theme/theme";
import "../assets/styles/global.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
}

const {
	title,
	description = "Albert Wei - Software Engineer & Developer",
	image = "/og-image.jpg",
	type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolveThemeValueSource = resolveThemeValue.toString();
const themeBootScript = `
try {
  const THEME_STORAGE_KEY = ${JSON.stringify(THEME_STORAGE_KEY)};
  const resolveThemeValue = ${resolveThemeValueSource};
  const stored = localStorage.getItem(THEME_STORAGE_KEY);
  const theme = resolveThemeValue(
    stored,
    window.matchMedia("(prefers-color-scheme: dark)").matches
  );
  document.documentElement.setAttribute("data-theme", theme);
  document.documentElement.style.colorScheme = theme;
} catch {}
`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Open Graph Preview -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter fallback="animate" />
    
    <script is:inline set:html={themeBootScript}></script>
    <script>
      import { initThemeController } from "../lib/theme/theme";

      initThemeController();
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only">Skip to main content</a>
    
    <!-- Page content injected here -->
    <slot />
  </body>
</html>
