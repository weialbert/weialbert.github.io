---
import ThemeToggle from "../ThemeToggle.astro";

const navItems = [
	{ href: "/", label: "Home", icon: "home" },
	{ href: "/about", label: "About", icon: "user" },
	{ href: "/projects", label: "Projects", icon: "briefcase" },
	{ href: "/photos", label: "Photos", icon: "camera" },
	{ href: "/blog", label: "Blog", icon: "book" },
	{ href: "/resume", label: "Resume", icon: "file" },
	{ href: "/contact", label: "Contact", icon: "mail" },
];

const currentPath = Astro.url.pathname;
const isActivePath = (href: string) =>
	currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<aside id="sidebar" class="sidebar" transition:animate="none">
  <div class="sidebar-header">
    <a href="/" class="logo">
      <span class="logo-text">Albert Wei</span>
    </a>

    <button
      type="button"
      class="mobile-close"
      data-mobile-menu-close
      aria-label="Close menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="18" y1="6" x2="6" y2="18" />
        <line x1="6" y1="6" x2="18" y2="18" />
      </svg>
    </button>
  </div>

  <nav class="sidebar-nav">
    <ul>
      {
        navItems.map((item) => (
          <li class="nav-item">
            <a
              href={item.href}
              class:list={[
                "nav-link",
                {
                  active: isActivePath(item.href),
                },
              ]}
              aria-current={isActivePath(item.href) ? "page" : undefined}
            >
              {isActivePath(item.href) && (
                <span
                  class="nav-bubble"
                  transition:name="desktop-nav-bubble"
                  aria-hidden="true"
                />
              )}
              <span class="nav-icon" data-icon={item.icon} />
              <span class="nav-label">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="sidebar-footer">
    <ThemeToggle />
  </div>
</aside>

<!-- Mobile Overlay -->
<button
  type="button"
  id="sidebar-overlay"
  class="sidebar-overlay"
  aria-label="Close menu"
></button>

<style>
  /* ============================================================================
     SIDEBAR LAYOUT
     ========================================================================= */

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: var(--sidebar-width);
    background-color: var(--color-card-bg);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    z-index: 1000;
    overflow: hidden;
  }

  /* ===== Sidebar Header ===== */
  .sidebar-header {
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .mobile-close {
    display: none;
  }

  .logo {
    text-decoration: none;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    transition: color var(--transition-fast);
  }

  .logo:hover {
    color: var(--color-accent);
  }

  /* ============================================================================
     NAVIGATION
     ========================================================================= */

  .sidebar-nav {
    flex: 1;
    padding: var(--space-lg) 0;
    overflow-y: auto;
  }

  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* ===== Navigation Links ===== */
  .nav-link {
    display: flex;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);
    position: relative;
    white-space: nowrap;
    isolation: isolate;
    z-index: 0;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  /* ===== Active State ===== */
  .nav-link.active {
    color: var(--color-text);
    font-weight: 600; /* ← Makes text bolder */
  }

  .nav-bubble {
    display: block;
    position: absolute;
    inset: 0.35rem 0.6rem;
    border-radius: 999px;
    background:
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-accent) 18%, transparent),
        color-mix(in srgb, var(--color-accent) 8%, var(--color-card-bg))
      );
    border: 1px solid color-mix(in srgb, var(--color-accent) 18%, var(--color-border));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.18),
      0 10px 24px rgba(12, 71, 165, 0.08);
    z-index: 0;
  }

  /* ===== Navigation Icon & Label ===== */
  .nav-icon {
    width: 20px;
    height: 20px;
    margin-right: var(--space-md);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  .nav-label {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    position: relative;
    z-index: 1;
  }

  .nav-link:hover:not(.active) {
    background-color: color-mix(in srgb, var(--color-bg-secondary) 70%, transparent);
  }

  /* ============================================================================
     SIDEBAR FOOTER
     ========================================================================= */

  .sidebar-footer {
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  /* ============================================================================
     MOBILE STYLES
     ========================================================================= */

  /* ===== Mobile Menu Toggle Button ===== */
  /* ===== Mobile Overlay (backdrop) ===== */
  .sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    border: 0;
    z-index: 999;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  @media (max-width: 768px) {
    /* ===== Hide sidebar off-screen by default ===== */
    .sidebar {
      width: min(86vw, 22rem);
      border-right: none;
      border-radius: 0 var(--radius-xl) var(--radius-xl) 0;
      box-shadow: 0 24px 60px rgba(15, 23, 42, 0.22);
      transform: translate3d(-104%, 0, 0);
      opacity: 0.98;
      will-change: transform;
      transition:
        transform 280ms var(--ease-smooth),
        opacity 180ms ease;
    }

    /* ===== Show sidebar when mobile-open ===== */
    .sidebar.mobile-open {
      transform: translate3d(0, 0, 0);
      opacity: 1;
    }

    .sidebar-header {
      padding-bottom: var(--space-md);
      border-bottom: none;
    }

    .mobile-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.25rem;
      height: 2.25rem;
      border-radius: 999px;
      border: 1px solid var(--color-border);
      background-color: var(--color-bg-secondary);
      color: var(--color-text);
      cursor: pointer;
      transition:
        color var(--transition-fast),
        background-color var(--transition-fast),
        border-color var(--transition-fast);
    }

    .mobile-close:hover {
      background-color: var(--color-card-bg);
      border-color: var(--color-accent);
      color: var(--color-accent);
    }

    .sidebar-nav {
      padding: var(--space-md);
      border-top: 1px solid var(--color-border);
    }

    .sidebar-nav ul {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .nav-bubble {
      display: none;
    }

    .nav-link {
      min-height: 3.25rem;
      padding: 0 var(--space-lg);
      border: 1px solid transparent;
      border-radius: var(--radius-lg);
      background-color: transparent;
    }

    .nav-link.active {
      background-color: color-mix(in srgb, var(--color-accent) 12%, var(--color-card-bg));
      border-color: color-mix(in srgb, var(--color-accent) 22%, var(--color-border));
      color: var(--color-text);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14);
    }

    .nav-link:hover:not(.active) {
      background-color: var(--color-bg-secondary);
    }

    /* ===== Show overlay when active ===== */
    .sidebar-overlay.active {
      display: block;
      opacity: 1;
    }
  }
</style>
