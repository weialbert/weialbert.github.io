---
import ThemeToggle from '../ThemeToggle.astro';

const navItems = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/about', label: 'About', icon: 'user' },
  { href: '/projects', label: 'Projects', icon: 'briefcase' },
  { href: '/photos', label: 'Photos', icon: 'camera' },
  { href: '/blog', label: 'Blog', icon: 'book' },
  { href: '/resume', label: 'Resume', icon: 'file' },
  { href: '/contact', label: 'Contact', icon: 'mail' },
];

const currentPath = Astro.url.pathname;
---

<aside id="sidebar" class="sidebar">
  <div class="sidebar-header">
    <a href="/" class="logo">
      <span class="logo-text">Albert Wei</span>
    </a>
  </div>
  
  <nav class="sidebar-nav">
    <ul>
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={['nav-link', { active: currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href)) }]}
            aria-current={currentPath === item.href ? 'page' : undefined}
          >
            <span class="nav-icon" data-icon={item.icon}></span>
            <span class="nav-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  
  <div class="sidebar-footer">
    <ThemeToggle />
  </div>
</aside>

<!-- Mobile Menu Toggle -->
<button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle mobile menu">
  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
    <line x1="3" y1="12" x2="21" y2="12"/>
    <line x1="3" y1="6" x2="21" y2="6"/>
    <line x1="3" y1="18" x2="21" y2="18"/>
  </svg>
</button>

<!-- Mobile Overlay -->
<div id="sidebar-overlay" class="sidebar-overlay"></div>

<script>
  // Mobile drawer functionality only
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const mobileToggle = document.getElementById('mobile-menu-toggle');
  
  function toggleMobileMenu() {
    if (!sidebar) return;
    sidebar.classList.toggle('mobile-open');
    overlay?.classList.toggle('active');
    document.body.style.overflow = sidebar?.classList.contains('mobile-open') ? 'hidden' : '';
  }
  
  function closeMobileMenu() {
    if (!sidebar) return;
    sidebar.classList.remove('mobile-open');
    overlay?.classList.remove('active');
    document.body.style.overflow = '';
  }
  
  mobileToggle?.addEventListener('click', toggleMobileMenu);
  overlay?.addEventListener('click', closeMobileMenu);
  
  // Close drawer on nav click
  document.querySelectorAll('.nav-link').forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: var(--sidebar-width);
    background-color: var(--color-card-bg);
    border-right: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    transition: width var(--transition-base);
    z-index: 1000;
    overflow: hidden;
  }
  
  .sidebar-header {
    padding: var(--space-lg);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }
  
  .logo {
    text-decoration: none;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
    transition: opacity var(--transition-base);
  }
  
  .sidebar-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: var(--space-sm);
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    transition: background-color var(--transition-fast);
    flex-shrink: 0;
  }
  
  .sidebar-toggle:hover {
    background-color: var(--color-bg-secondary);
  }
  
  .sidebar-nav {
    flex: 1;
    padding: var(--space-lg) 0;
    overflow-y: auto;
  }
  
  .sidebar-nav ul {
    list-style: none;
  }
  
  .nav-link {
    display: flex;
    align-items: center;
    padding: var(--space-md) var(--space-lg);
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all var(--transition-fast);
    position: relative;
    white-space: nowrap;
  }
  
  .nav-link:hover {
    background-color: var(--color-bg-secondary);
    color: var(--color-text);
  }
  
  .nav-link.active {
    color: var(--color-accent);
    background-color: var(--color-bg-secondary);
  }
  
  .nav-link.active::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background-color: var(--color-accent);
  }
  
  .nav-icon {
    width: 20px;
    height: 20px;
    margin-right: var(--space-md);
    flex-shrink: 0;
  }
  
  .nav-label {
    white-space: nowrap;
    transition: opacity var(--transition-fast);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  
  .sidebar-footer {
    padding: var(--space-lg);
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
  }
  
  /* Collapsed state (desktop) */
  @media (min-width: 769px) {
    /* Collapsed state removed - sidebar is always visible */
  }
  
  /* Mobile styles */
  @media (max-width: 768px) {
    .sidebar {
      width: var(--sidebar-width);
      transform: translateX(-100%);
      transition: transform var(--transition-base);
    }
    
    .sidebar.mobile-open {
      transform: translateX(0);
    }
  }
  
  .mobile-menu-toggle {
    display: none;
  }
  
  @media (max-width: 768px) {
    .mobile-menu-toggle {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      top: 1rem;
      left: 1rem;
      background-color: var(--color-card-bg);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-sm);
      cursor: pointer;
      color: var(--color-text);
      width: 40px;
      height: 40px;
      z-index: 999;
    }
    
    .mobile-menu-toggle:hover {
      background-color: var(--color-bg-secondary);
    }
  }
  
  .sidebar-overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 999;
    opacity: 0;
    transition: opacity var(--transition-base);
  }
  
  @media (max-width: 768px) {
    .sidebar-overlay.active {
      display: block;
      opacity: 1;
    }
  }
</style>