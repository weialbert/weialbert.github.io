<header class="header">
  <div class="header-content">
    <a href="/" class="mobile-brand">Albert Wei</a>

    <div class="mobile-header-actions">
      <button
        type="button"
        class="mobile-menu-toggle"
        data-mobile-menu-toggle
        aria-label="Open menu"
        aria-controls="sidebar"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="12" x2="21" y2="12"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  /* ===== Mobile-only Header ===== */
  .header {
    display: none;
    background-color: var(--color-card-bg);
    border-bottom: 1px solid var(--color-border);
    padding:
      calc(0.55rem + env(safe-area-inset-top, 0px))
      var(--space-lg)
      0.9rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }
  
  .header-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .mobile-brand {
    color: var(--color-text);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    text-decoration: none;
  }

  .mobile-header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  
  /* ===== Mobile Menu Toggle Button ===== */
  .mobile-menu-toggle {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, white 10%, var(--color-card-bg)),
        color-mix(in srgb, var(--color-bg-secondary) 78%, var(--color-card-bg))
      );
    border: 1px solid color-mix(in srgb, var(--color-border) 88%, transparent);
    cursor: pointer;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.16),
      0 8px 20px rgba(15, 23, 42, 0.08);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }
  
  .mobile-menu-toggle:hover {
    color: var(--color-accent);
    border-color: color-mix(in srgb, var(--color-accent) 28%, var(--color-border));
    transform: translate3d(0, -1px, 0);
  }

  .mobile-menu-toggle[aria-expanded="true"] {
    color: var(--color-accent);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-accent) 12%, var(--color-card-bg)),
        color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-secondary))
      );
    border-color: color-mix(in srgb, var(--color-accent) 24%, var(--color-border));
  }
  
  /* ===== Show header on mobile ===== */
  @media (max-width: 768px) {
    .header {
      display: block;
    }
  }
</style>
